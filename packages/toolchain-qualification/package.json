{
  "name": "@opshub/toolchain-qualification",
  "version": "0.0.0",
  "private": true,
  "description": "T0002 isolated compatibility package: pinned Node 24, NestJS (Express), TypeScript decorators, React/Vite and Vitest. Synthetic only; not an application.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:negative": "tsc -p tsconfig.negative.json --noEmit",
    "test": "vitest run",
    "test:transpile-only": "vitest run --config vitest.negative.config.ts",
    "build:client": "vite build",
    "check": "npm run typecheck && npm run test && npm run build:client"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
